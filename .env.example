# Copy to .env. Everything is optional — leave blank to run in mock/degraded mode.

ENV=dev
LOG_LEVEL=INFO

# Auth — share JWT_SECRET with the Node platform. Set AUTH_OPTIONAL=false in prod.
AUTH_OPTIONAL=true
JWT_SECRET=dev-secret-change-me
JWT_AUDIENCE=devel

# MongoDB — same cluster as the devora platform DB. Tutor data lives in `ai_tutor`.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_DB=ai_tutor
VECTOR_COLLECTION=content_chunks
VECTOR_INDEX=content_vindex

# Optional services
# REDIS_URL=redis://localhost:6379/0
# PLATFORM_API_URL=http://localhost:5000

# Gemini (leave blank for the mock tutor)
# GEMINI_API_KEY=AIza...
MODEL_SMART=gemini-2.5-flash
MODEL_FAST=gemini-2.5-flash
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.6
RETRIEVAL_K=6
